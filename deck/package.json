  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright-chromium": "~1.56.1",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.0"
  }
